<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- User-configured local/LAN development APIs may use HTTP without credentials.
         CredentialTransportPolicy separately requires HTTPS for all non-loopback Bearer keys. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors><certificates src="system" /></trust-anchors>
    </base-config>
</network-security-config>
